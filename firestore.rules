rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isPublicSaleRoundStatus(status) {
      return status in ['SCHEDULED', 'OPEN', 'CLOSED', 'COMPLETED'];
    }

    function isRoundDirectStore(storeId) {
      let storePath = /databases/$(database)/documents/stores/$(storeId);
      return storeId is string &&
        exists(storePath) &&
        get(storePath).data.get('salesMode', null) == 'round_direct';
    }

    function isPublicSaleRound(round) {
      let storeId = round.data.get('storeId', null);
      return storeId is string &&
        isRoundDirectStore(storeId) &&
        isPublicSaleRoundStatus(round.data.get('status', null));
    }

    function isPublicSaleRoundItem(roundId, storeId) {
      let roundPath = /databases/$(database)/documents/saleRounds/$(roundId);
      return storeId is string &&
        exists(roundPath) &&
        isRoundDirectStore(storeId) &&
        get(roundPath).data.get('storeId', null) == storeId &&
        isPublicSaleRoundStatus(get(roundPath).data.get('status', null));
    }

    function currentUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserExists() {
      return request.auth != null && exists(currentUserPath());
    }

    function activeCurrentUser() {
      return currentUserExists() &&
        get(currentUserPath()).data.get('suspended', false) != true;
    }

    function currentRole(role) {
      return activeCurrentUser() &&
        request.auth.token.get('role', null) == role &&
        get(currentUserPath()).data.get('role', null) == role;
    }

    function currentSellerFor(storeId) {
      return currentRole('seller') &&
        request.auth.token.get('storeId', null) == storeId &&
        get(currentUserPath()).data.get('storeId', null) == storeId;
    }

    function currentAdmin() {
      return currentRole('admin');
    }

    // Canonical seller ownership: API는 stores/{storeId}.ownerId == uid를
    // 정본으로 사용한다 (products/sale-rounds/stores services + specs).
    // Rules는 token storeId + users storeId + ownerId를 모두 요구하는
    // conjunction으로 API보다 약하지 않게 fail-closed한다.
    // users.storeId와 stores.ownerId가 divergent하면 DENY (migration 없음).
    function isStoreOwner(storeId) {
      let storePath = /databases/$(database)/documents/stores/$(storeId);
      return storeId is string &&
        exists(storePath) &&
        get(storePath).data.get('ownerId', null) == request.auth.uid;
    }

    function currentSellerOwnsStore(storeId) {
      return currentSellerFor(storeId) && isStoreOwner(storeId);
    }

    // orders: 매장 소유자·관리자만 직접 읽고 기사는 API를 사용한다
    match /orders/{orderId} {
      allow read: if currentSellerFor(resource.data.storeId) || currentAdmin();
      allow write: if false;
    }

    // products: anonymous raw read는 PR #141에서 차단됨. 이번 Task는
    // bare-authenticated raw read를 닫는다. own-store owning seller와
    // canonical admin만 허용. consumer/driver/other-store seller DENY.
    // Seller own-store query (where storeId == own storeId)는 유지되며
    // inactive/testOnly도 owner 관리 목적으로 허용한다 (public predicate 미적용).
    match /products/{productId} {
      allow get, list: if currentSellerOwnsStore(resource.data.get('storeId', null)) ||
        currentAdmin();
      allow write: if false;
    }

    // stores: anonymous raw get은 PR #141에서 차단됨. 이번 Task는
    // bare-authenticated raw get을 닫는다. resource.ownerId를 사용해
    // extra lookup 없이 판정한다 (list는 기존처럼 DENY).
    // ownerId/ceoName/phone/address/businessNumber/status 등 비공개 필드 보호.
    match /stores/{storeId} {
      allow get: if (currentSellerFor(storeId) &&
        resource.data.get('ownerId', null) == request.auth.uid) || currentAdmin();
      allow list, write: if false;
    }

    // dailyCaps: 소비자 배송일 picker가 직접 구독 (공개 잔여 ظرفیت, PII 없음).
    // REST daily-caps는 seller 전용이므로 consumer 직접 읽기를 유지한다.
    match /dailyCaps/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // groupProductConfig: anonymous raw read는 PR #141에서 차단됨. 이번 Task는
    // bare-authenticated raw read를 닫는다. point get만 owner/admin에게 허용하고
    // list는 DENY를 유지한다 (shipped owner workflow가 list를 요구하지 않음).
    // products/{docId}.storeId를 authoritative relation으로 사용하며
    // groupProductConfig 자체의 storeId denormalization에 의존하지 않는다.
    // create path가 storeId를 보장하지 않아도 동작한다. 새 migration 없음.
    match /groupProductConfig/{docId} {
      allow get: if (exists(/databases/$(database)/documents/products/$(docId)) &&
        currentSellerOwnsStore(get(/databases/$(database)/documents/products/$(docId)).data.get('storeId', null))) ||
        currentAdmin();
      allow list, write: if false;
    }

    // varieties: 소비자 상품 상세에 필요한 공개 품종 단건 조회만 허용
    match /varieties/{varietyId} {
      allow get: if true;
      allow list, write: if false;
    }

    // 공개 판매 회차: 소비자 조회만 허용하고 모든 클라이언트 직접 쓰기 차단
    match /saleRounds/{roundId} {
      allow read: if isPublicSaleRound(resource);
      allow write: if false;
    }

    match /saleRoundItems/{roundItemId} {
      allow read: if isPublicSaleRoundItem(resource.data.roundId, resource.data.storeId)
        && resource.data.status != 'HIDDEN';
      allow write: if false;
    }

    // 결제 예약·운영·법정 보관·알림 전달 기록: Admin SDK를 사용하는 서버 전용
    match /checkoutReservations/{reservationId} {
      allow read, write: if false;
    }

    match /operationIssues/{issueId} {
      allow read, write: if false;
    }

    match /legalOrderRecords/{recordId} {
      allow read, write: if false;
    }

    match /legalDisputeRecords/{recordId} {
      allow read, write: if false;
    }

    match /marketingConsentLogs/{recordId} {
      allow read, write: if false;
    }

    match /deliveryPhotoRecords/{recordId} {
      allow read, write: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    // 나머지 모든 컬렉션: 클라이언트 직접 접근 차단 (서버만)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
