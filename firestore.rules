rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // orders: Firebase Auth 필수 + 본인 storeId, admin, driver 허용
    match /orders/{orderId} {
      allow read: if request.auth != null &&
        (resource.data.storeId == request.auth.token.storeId ||
         request.auth.token.role == 'admin' ||
         request.auth.token.role == 'driver');
      allow write: if false;
    }

    // products: 읽기 전체 허용 (공개 상품 데이터 — seller 실시간 리스너 + consumer 조회)
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // stores: 단일 문서 get만 허용 (상품 상세 판매자 정보 노출용)
    match /stores/{storeId} {
      allow get: if true;
      allow list, write: if false;
    }

    // dailyCaps, groupProductConfig: 소비자 앱 공개 읽기 (상품 재고/공동구매 현황)
    match /dailyCaps/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /groupProductConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 나머지 모든 컬렉션: 클라이언트 직접 접근 차단 (서버만)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
