rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function currentUserExists() {
      return signedIn() && firestore.exists(currentUserPath());
    }

    function activeCurrentUser() {
      return currentUserExists() &&
        firestore.get(currentUserPath()).data.get('suspended', false) != true;
    }

    function currentRole(role) {
      return activeCurrentUser() &&
        request.auth.token.get('role', null) == role &&
        firestore.get(currentUserPath()).data.get('role', null) == role;
    }

    function isAdmin() {
      return currentRole('admin');
    }

    function isSellerFor(storeId) {
      return currentRole('seller') &&
        request.auth.token.get('storeId', null) == storeId &&
        firestore.get(currentUserPath()).data.get('storeId', null) == storeId;
    }

    function isDriver() {
      return currentRole('driver') &&
        request.auth.token.get('driverApproved', false) == true &&
        firestore.get(currentUserPath()).data.get('driverApproved', false) == true;
    }

    function isOwnedSellerLogo(fileName) {
      return currentRole('seller') &&
        fileName.split('_').size() == 2 &&
        fileName.split('_')[0] == request.auth.uid &&
        fileName.split('_')[1].matches('[0-9]+');
    }

    function isProductImage() {
      return request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp',
          'image/gif'
        ];
    }

    function isLogoImage() {
      return request.resource != null &&
        request.resource.size <= 2 * 1024 * 1024 &&
        request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function legacyOrderId(fileName) {
      let parts = fileName.split('_');
      return parts[0:parts.size() - 1].join('_');
    }

    function isLegacyDeliveryPhotoName(fileName) {
      let parts = fileName.split('_');
      return parts.size() >= 2 &&
        legacyOrderId(fileName).matches('[A-Za-z0-9_-]{1,128}') &&
        parts[parts.size() - 1].matches('[0-9]+\\.jpg');
    }

    function legacyOrder(fileName) {
      return firestore.get(
        /databases/(default)/documents/orders/$(legacyOrderId(fileName))
      );
    }

    function isAssignedLegacyHubDriver(fileName) {
      let order = legacyOrder(fileName);
      return isDriver() &&
        order.data.driverId == request.auth.uid &&
        order.data.deliveryMethod == 'hub';
    }

    function isLegacyDeliveryPhoto(fileName) {
      return isLegacyDeliveryPhotoName(fileName) &&
        request.resource != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
    }

    // 공개 상품 이미지: 소유 판매자와 관리자만 변경
    match /products/{storeId}/{fileName} {
      allow read: if true;
      allow create, update: if isProductImage() &&
        (isSellerFor(storeId) || isAdmin());
      allow delete: if isSellerFor(storeId) || isAdmin();
    }

    // 공개 메인 배너: 관리자만 변경
    match /banners/main_hero/{fileName} {
      allow read: if true;
      allow create, update: if isProductImage() && isAdmin();
      allow delete: if isAdmin();
    }

    // 공개 상점 로고: 판매자 본인 이름의 객체만 변경
    match /logos/{fileName} {
      allow read: if true;
      allow create, update: if isLogoImage() && isOwnedSellerLogo(fileName);
      allow delete: if isOwnedSellerLogo(fileName);
    }

    // 기존 거점 사진: 담당 기사의 단건 읽기와 배송 중 JPEG 생성만 허용
    match /deliveryPhotos/{fileName} {
      allow get: if isLegacyDeliveryPhotoName(fileName) &&
        isAssignedLegacyHubDriver(fileName);
      allow list: if false;
      allow create: if resource == null &&
        isLegacyDeliveryPhoto(fileName) &&
        isAssignedLegacyHubDriver(fileName) &&
        legacyOrder(fileName).data.status == 'DELIVERING';
      allow update, delete: if false;
    }

    // 회차 직배송 사진: Admin SDK 서버 업로드와 서명 URL만 사용
    match /deliveryPhotos/{orderId}/{fileName} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
