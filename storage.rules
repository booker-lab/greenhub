rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 상품 이미지: 인증된 사용자만 업로드, 누구나 읽기
    match /products/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 배너 이미지: 인증된 사용자만 업로드, 누구나 읽기
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 상점 로고: 공개 읽기, 인증 사용자 업로드 허용
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
