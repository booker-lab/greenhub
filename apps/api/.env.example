# Firebase
FIREBASE_PROJECT_ID=green-e4fe3
# 로컬: JSON 파일 경로 방식
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json
# Railway 배포 시: JSON 문자열 전체를 Secret으로 등록 (GOOGLE_APPLICATION_CREDENTIALS 대신 사용)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"green-e4fe3",...}

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Portone (포트원) — Step 6 시작 전 발급
PORTONE_API_KEY=
PORTONE_API_SECRET=
PORTONE_V2_SECRET=
PORTONE_WEBHOOK_SECRET=   # Portone 콘솔 > 웹훅 > 서명 키 (whsec_ 포함)

# Aligo (알리고 알림톡) — Step 7 시작 전 발급
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER_PHONE=

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Gemini AI 설정
GEMINI_API_KEY=
# 선택값: 비워두면 코드 기본값을 사용한다.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_LEGACY_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_LEGACY_FALLBACK_LITE_MODEL=gemini-2.5-flash-lite
