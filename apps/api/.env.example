# Firebase
FIREBASE_PROJECT_ID=green-e4fe3
FIREBASE_STORAGE_BUCKET=green-e4fe3.appspot.com
# 로컬·관리형 환경: ADC가 읽을 서비스 계정 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json
# Railway 배포 시: JSON 문자열 전체를 Secret으로 등록하면 위 ADC보다 우선한다.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# JWT
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Portone (포트원) v2 — 운영에서는 두 secret 모두 필수
PORTONE_V2_SECRET=
PORTONE_WEBHOOK_SECRET=   # Portone 콘솔 > 웹훅 > 서명 키 (whsec_ 포함)

# Aligo (알리고 알림톡) — Step 7 시작 전 발급
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER_PHONE=
# 내부 논리 코드와 ALIGO tpl_code의 JSON 객체 매핑. 실제 코드는 저장소에 기록하지 않습니다.
ALIGO_TEMPLATE_CODES_JSON={}

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# 로컬 드라이버 브라우저 게이트는 Firebase 에뮬레이터와 로컬 식별자만 사용합니다.
# 로컬 M2 바인딩은 세 에뮬레이터 호스트와 정확한 로컬 프로젝트·버킷을 함께 사용해야 합니다.
# GOOGLE_APPLICATION_CREDENTIALS 또는 Firebase 서비스 계정 JSON·경로는 설정하지 않습니다.
# GREENHUB_LOCAL_RUNTIME=true
# GREENHUB_SCHEDULES_ENABLED=false
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# FIREBASE_PROJECT_ID=greenhub-local
# FIREBASE_STORAGE_BUCKET=greenhub-local.appspot.com
