# Firebase — 로컬·비운영에서는 비운영 project만 쓴다. 운영 project를 가리키는 설정이나
# 기본 자격 증명(키 파일 project_id, GOOGLE_CLOUD_PROJECT, GCLOUD_PROJECT)은 비운영 기동이 거부된다.
FIREBASE_PROJECT_ID=replace-with-non-production-project
FIREBASE_STORAGE_BUCKET=replace-with-non-production-project.appspot.com
# 비운영 관리형 환경: ADC가 읽을 비운영 서비스 계정 파일 경로(운영 키를 두지 않는다)
# GOOGLE_APPLICATION_CREDENTIALS=./non-production-service-account.json
# Railway 배포 시: JSON 문자열 전체를 Secret으로 등록하면 위 ADC보다 우선한다.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# JWT — 운영에서는 두 secret이 서로 달라야 기동한다(32바이트 미만이면 경고).
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Portone (포트원) v2 — 운영에서는 두 secret 모두 필수
PORTONE_V2_SECRET=
PORTONE_WEBHOOK_SECRET=   # Portone 콘솔 > 웹훅 > 서명 키 (whsec_ 포함)

# Aligo (알리고 알림톡) — Step 7 시작 전 발급
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER_PHONE=
# 내부 논리 코드와 ALIGO tpl_code의 JSON 객체 매핑. 실제 코드는 저장소에 기록하지 않습니다.
ALIGO_TEMPLATE_CODES_JSON={}

# App
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
# Vercel Preview origin 허용. 미설정이면 비운영 런타임만 허용하고 운영 런타임은 거부한다.
# 운영 API에서 Preview origin을 받아야 할 때만 true로 명시한다.
# CORS_ALLOW_VERCEL_PREVIEWS=false
# 요청 한도 집계용 클라이언트 IP를 정할 때 신뢰할 프록시 홉 수(0~10 정수).
# 미설정이면 Railway 런타임은 1(엣지 프록시), 그 밖(로컬)은 0(X-Forwarded-For 미신뢰).
# TRUST_PROXY_HOPS=0

# Local Driver browser gate (Firebase emulators only; never use a production project here)
# GREENHUB_LOCAL_RUNTIME=true
# GREENHUB_SCHEDULES_ENABLED=false
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
