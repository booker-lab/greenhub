# ── NextAuth.js v5 ────────────────────────────────────────────
# 실제 런타임 이름은 AUTH_SECRET입니다. NEXTAUTH_SECRET은 사용하지 않습니다.
AUTH_SECRET=
# 카카오 OAuth 앱 설정
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 프로덕션: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3001

# ── API 서버 ──────────────────────────────────────────────────
# 프로덕션: Railway 배포 후 발급된 URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Firebase 클라이언트 SDK ────────────────────────────────────
# NEXT_PUBLIC_FIREBASE_PROJECT_ID는 API의 FIREBASE_PROJECT_ID와 같은 환경을 가리켜야 합니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=green-e4fe3.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=green-e4fe3
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=green-e4fe3.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── 포트원 (Portone) v2 ───────────────────────────────────────
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_KAKAOPAY_CHANNEL_KEY=
# 네이버페이 파트너 승인 후 Portone 콘솔에서 발급 — 없으면 결제 수단에서 자동 숨김
NEXT_PUBLIC_PORTONE_NAVERPAY_CHANNEL_KEY=
